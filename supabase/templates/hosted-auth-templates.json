{
  "mailer_subjects_confirmation": "Confirm your email for Kinra",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Confirm your email for Kinra</title>\n<style>body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}table,td{mso-table-lspace:0;mso-table-rspace:0}table{border-collapse:collapse}img{border:0;outline:none}a{overflow-wrap:anywhere}a:focus-visible{outline:2px solid #79d5e7;outline-offset:4px}@media(max-width:480px){.outer{padding:20px 12px!important}.pad{padding-left:24px!important;padding-right:24px!important}.headline{font-size:34px!important}.action{display:block!important;text-align:center!important}}@media(prefers-color-scheme:dark){.canvas{background:#0f1013!important}.card{background:#1a1c20!important}.copy{color:#f5f6f8!important}.muted{color:#c6c9d0!important}.cta{background:#c4f65b!important;color:#18200e!important}}</style></head>\n<body class=\"canvas\" bgcolor=\"#0f1013\" style=\"margin:0;padding:0;background:#0f1013;color:#f5f6f8;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all\">Confirm your email to finish setting up Kinra. Your space for training, nutrition and recovery starts here.</div>\n<table role=\"presentation\" width=\"100%\" class=\"canvas\" bgcolor=\"#0f1013\"><tr><td class=\"outer\" align=\"center\" style=\"padding:48px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"560\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" style=\"max-width:560px\">\n<tr><td class=\"pad\" style=\"padding:0 36px 26px\"><table role=\"presentation\"><tr><td width=\"48\"><img src=\"{{ .SiteURL }}/brand/kinra-mark.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;width:40px;height:40px\"></td><td style=\"font-size:25px;font-weight:900;letter-spacing:1px;color:#f5f6f8\">KINRA<span style=\"color:#c4f65b\">.</span></td></tr></table></td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:36px 36px 0;background:#1a1c20;border-top:3px solid #c4f65b;border-radius:20px 20px 0 0\">\n<p style=\"margin:0 0 18px;font-family:'Courier New',monospace;font-size:11px;font-weight:bold;line-height:18px;letter-spacing:2px;color:#79d5e7\">MAKE IT YOURS</p>\n<h1 class=\"headline copy\" style=\"margin:0;font-size:40px;font-weight:900;line-height:1.08;letter-spacing:-1.5px;color:#f5f6f8\">Your next chapter.<br>One step away.</h1>\n<p class=\"muted\" style=\"margin:24px 0 28px;font-size:16px;line-height:26px;color:#c6c9d0\">Confirm your email to finish setting up Kinra. Your space for training, nutrition and recovery starts here.</p>\n<table role=\"presentation\" width=\"100%\" style=\"margin:0 0 28px\"><tr><td class=\"cta\" align=\"center\" bgcolor=\"#c4f65b\" style=\"background:#c4f65b;border-radius:12px;mso-padding-alt:18px 24px\"><a class=\"cta action\" href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:18px 24px;border:1px solid #c4f65b;border-radius:12px;font-size:16px;line-height:20px;font-weight:bold;color:#18200e;background:#c4f65b;text-decoration:none\">Confirm email &nbsp; &#8594;</a></td></tr></table>\n<p class=\"muted\" style=\"margin:0 0 28px;padding-left:16px;border-left:2px solid #79d5e7;font-size:13px;line-height:21px;color:#c6c9d0\">This link works once. If it has expired, return to Kinra and request a new confirmation email.</p>\n</td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:0 36px 32px;background:#1a1c20;border-radius:0 0 20px 20px\">\n<div style=\"border-top:1px solid #363a42;padding-top:22px\"><p class=\"muted\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#c6c9d0\">Button not working? Copy this link into your browser:</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;font-size:12px;line-height:20px;color:#c4f65b;word-break:break-all;overflow-wrap:anywhere;text-decoration:underline\">{{ .ConfirmationURL }}</a></div>\n</td></tr>\n<tr><td class=\"pad muted\" style=\"padding:24px 36px 0;font-size:12px;line-height:20px;color:#a9aeb8\"><p style=\"margin:0 0 24px\">If you didn’t create a Kinra account, you can ignore this email. Keep this link private.</p><p style=\"margin:0;color:#c6c9d0;font-family:'Courier New',monospace;font-size:10px;letter-spacing:2px\">TRAIN. FUEL. RECOVER.</p><p style=\"margin:8px 0 0\">Your progress, in one place.</p></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n",
  "mailer_subjects_recovery": "Reset your Kinra password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Reset your Kinra password</title>\n<style>body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}table,td{mso-table-lspace:0;mso-table-rspace:0}table{border-collapse:collapse}img{border:0;outline:none}a{overflow-wrap:anywhere}a:focus-visible{outline:2px solid #79d5e7;outline-offset:4px}@media(max-width:480px){.outer{padding:20px 12px!important}.pad{padding-left:24px!important;padding-right:24px!important}.headline{font-size:34px!important}.action{display:block!important;text-align:center!important}}@media(prefers-color-scheme:dark){.canvas{background:#0f1013!important}.card{background:#1a1c20!important}.copy{color:#f5f6f8!important}.muted{color:#c6c9d0!important}.cta{background:#c4f65b!important;color:#18200e!important}}</style></head>\n<body class=\"canvas\" bgcolor=\"#0f1013\" style=\"margin:0;padding:0;background:#0f1013;color:#f5f6f8;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all\">You requested a password reset. Follow the link below to choose a new password and get back into your account.</div>\n<table role=\"presentation\" width=\"100%\" class=\"canvas\" bgcolor=\"#0f1013\"><tr><td class=\"outer\" align=\"center\" style=\"padding:48px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"560\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" style=\"max-width:560px\">\n<tr><td class=\"pad\" style=\"padding:0 36px 26px\"><table role=\"presentation\"><tr><td width=\"48\"><img src=\"{{ .SiteURL }}/brand/kinra-mark.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;width:40px;height:40px\"></td><td style=\"font-size:25px;font-weight:900;letter-spacing:1px;color:#f5f6f8\">KINRA<span style=\"color:#c4f65b\">.</span></td></tr></table></td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:36px 36px 0;background:#1a1c20;border-top:3px solid #c4f65b;border-radius:20px 20px 0 0\">\n<p style=\"margin:0 0 18px;font-family:'Courier New',monospace;font-size:11px;font-weight:bold;line-height:18px;letter-spacing:2px;color:#79d5e7\">ACCOUNT RECOVERY</p>\n<h1 class=\"headline copy\" style=\"margin:0;font-size:40px;font-weight:900;line-height:1.08;letter-spacing:-1.5px;color:#f5f6f8\">Get back<br>to your rhythm.</h1>\n<p class=\"muted\" style=\"margin:24px 0 28px;font-size:16px;line-height:26px;color:#c6c9d0\">You requested a password reset. Follow the link below to choose a new password and get back into your account.</p>\n<table role=\"presentation\" width=\"100%\" style=\"margin:0 0 28px\"><tr><td class=\"cta\" align=\"center\" bgcolor=\"#c4f65b\" style=\"background:#c4f65b;border-radius:12px;mso-padding-alt:18px 24px\"><a class=\"cta action\" href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:18px 24px;border:1px solid #c4f65b;border-radius:12px;font-size:16px;line-height:20px;font-weight:bold;color:#18200e;background:#c4f65b;text-decoration:none\">Reset password &nbsp; &#8594;</a></td></tr></table>\n<p class=\"muted\" style=\"margin:0 0 28px;padding-left:16px;border-left:2px solid #79d5e7;font-size:13px;line-height:21px;color:#c6c9d0\">This link works once. If it has expired, request another reset from the Kinra sign-in screen.</p>\n</td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:0 36px 32px;background:#1a1c20;border-radius:0 0 20px 20px\">\n<div style=\"border-top:1px solid #363a42;padding-top:22px\"><p class=\"muted\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#c6c9d0\">Button not working? Copy this link into your browser:</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;font-size:12px;line-height:20px;color:#c4f65b;word-break:break-all;overflow-wrap:anywhere;text-decoration:underline\">{{ .ConfirmationURL }}</a></div>\n</td></tr>\n<tr><td class=\"pad muted\" style=\"padding:24px 36px 0;font-size:12px;line-height:20px;color:#a9aeb8\"><p style=\"margin:0 0 24px\">If you didn’t request this, ignore this email. Your password will stay the same. Keep this link private.</p><p style=\"margin:0;color:#c6c9d0;font-family:'Courier New',monospace;font-size:10px;letter-spacing:2px\">TRAIN. FUEL. RECOVER.</p><p style=\"margin:8px 0 0\">Your progress, in one place.</p></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n",
  "mailer_subjects_magic_link": "Your Kinra sign-in link",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Your Kinra sign-in link</title>\n<style>body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}table,td{mso-table-lspace:0;mso-table-rspace:0}table{border-collapse:collapse}img{border:0;outline:none}a{overflow-wrap:anywhere}a:focus-visible{outline:2px solid #79d5e7;outline-offset:4px}@media(max-width:480px){.outer{padding:20px 12px!important}.pad{padding-left:24px!important;padding-right:24px!important}.headline{font-size:34px!important}.action{display:block!important;text-align:center!important}}@media(prefers-color-scheme:dark){.canvas{background:#0f1013!important}.card{background:#1a1c20!important}.copy{color:#f5f6f8!important}.muted{color:#c6c9d0!important}.cta{background:#c4f65b!important;color:#18200e!important}}</style></head>\n<body class=\"canvas\" bgcolor=\"#0f1013\" style=\"margin:0;padding:0;background:#0f1013;color:#f5f6f8;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all\">Use this secure link to sign in to your Kinra account and pick up where you left off.</div>\n<table role=\"presentation\" width=\"100%\" class=\"canvas\" bgcolor=\"#0f1013\"><tr><td class=\"outer\" align=\"center\" style=\"padding:48px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"560\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" style=\"max-width:560px\">\n<tr><td class=\"pad\" style=\"padding:0 36px 26px\"><table role=\"presentation\"><tr><td width=\"48\"><img src=\"{{ .SiteURL }}/brand/kinra-mark.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;width:40px;height:40px\"></td><td style=\"font-size:25px;font-weight:900;letter-spacing:1px;color:#f5f6f8\">KINRA<span style=\"color:#c4f65b\">.</span></td></tr></table></td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:36px 36px 0;background:#1a1c20;border-top:3px solid #c4f65b;border-radius:20px 20px 0 0\">\n<p style=\"margin:0 0 18px;font-family:'Courier New',monospace;font-size:11px;font-weight:bold;line-height:18px;letter-spacing:2px;color:#79d5e7\">YOUR WAY BACK IN</p>\n<h1 class=\"headline copy\" style=\"margin:0;font-size:40px;font-weight:900;line-height:1.08;letter-spacing:-1.5px;color:#f5f6f8\">Ready when<br>you are.</h1>\n<p class=\"muted\" style=\"margin:24px 0 28px;font-size:16px;line-height:26px;color:#c6c9d0\">Use this secure link to sign in to your Kinra account and pick up where you left off.</p>\n<table role=\"presentation\" width=\"100%\" style=\"margin:0 0 28px\"><tr><td class=\"cta\" align=\"center\" bgcolor=\"#c4f65b\" style=\"background:#c4f65b;border-radius:12px;mso-padding-alt:18px 24px\"><a class=\"cta action\" href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:18px 24px;border:1px solid #c4f65b;border-radius:12px;font-size:16px;line-height:20px;font-weight:bold;color:#18200e;background:#c4f65b;text-decoration:none\">Sign in to Kinra &nbsp; &#8594;</a></td></tr></table>\n<p class=\"muted\" style=\"margin:0 0 28px;padding-left:16px;border-left:2px solid #79d5e7;font-size:13px;line-height:21px;color:#c6c9d0\">This link works once. Open it on the device where you want to use Kinra.</p>\n</td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:0 36px 32px;background:#1a1c20;border-radius:0 0 20px 20px\">\n<div style=\"border-top:1px solid #363a42;padding-top:22px\"><p class=\"muted\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#c6c9d0\">Button not working? Copy this link into your browser:</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;font-size:12px;line-height:20px;color:#c4f65b;word-break:break-all;overflow-wrap:anywhere;text-decoration:underline\">{{ .ConfirmationURL }}</a></div>\n</td></tr>\n<tr><td class=\"pad muted\" style=\"padding:24px 36px 0;font-size:12px;line-height:20px;color:#a9aeb8\"><p style=\"margin:0 0 24px\">If you didn’t request a sign-in link, you can ignore this email. Keep this link private.</p><p style=\"margin:0;color:#c6c9d0;font-family:'Courier New',monospace;font-size:10px;letter-spacing:2px\">TRAIN. FUEL. RECOVER.</p><p style=\"margin:8px 0 0\">Your progress, in one place.</p></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n",
  "mailer_subjects_invite": "You’re invited to Kinra",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>You’re invited to Kinra</title>\n<style>body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}table,td{mso-table-lspace:0;mso-table-rspace:0}table{border-collapse:collapse}img{border:0;outline:none}a{overflow-wrap:anywhere}a:focus-visible{outline:2px solid #79d5e7;outline-offset:4px}@media(max-width:480px){.outer{padding:20px 12px!important}.pad{padding-left:24px!important;padding-right:24px!important}.headline{font-size:34px!important}.action{display:block!important;text-align:center!important}}@media(prefers-color-scheme:dark){.canvas{background:#0f1013!important}.card{background:#1a1c20!important}.copy{color:#f5f6f8!important}.muted{color:#c6c9d0!important}.cta{background:#c4f65b!important;color:#18200e!important}}</style></head>\n<body class=\"canvas\" bgcolor=\"#0f1013\" style=\"margin:0;padding:0;background:#0f1013;color:#f5f6f8;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all\">You’ve been invited to create a Kinra account. Open your invitation to get started with training, nutrition and recovery in one place.</div>\n<table role=\"presentation\" width=\"100%\" class=\"canvas\" bgcolor=\"#0f1013\"><tr><td class=\"outer\" align=\"center\" style=\"padding:48px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"560\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" style=\"max-width:560px\">\n<tr><td class=\"pad\" style=\"padding:0 36px 26px\"><table role=\"presentation\"><tr><td width=\"48\"><img src=\"{{ .SiteURL }}/brand/kinra-mark.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;width:40px;height:40px\"></td><td style=\"font-size:25px;font-weight:900;letter-spacing:1px;color:#f5f6f8\">KINRA<span style=\"color:#c4f65b\">.</span></td></tr></table></td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:36px 36px 0;background:#1a1c20;border-top:3px solid #c4f65b;border-radius:20px 20px 0 0\">\n<p style=\"margin:0 0 18px;font-family:'Courier New',monospace;font-size:11px;font-weight:bold;line-height:18px;letter-spacing:2px;color:#79d5e7\">A PLACE FOR YOUR PROGRESS</p>\n<h1 class=\"headline copy\" style=\"margin:0;font-size:40px;font-weight:900;line-height:1.08;letter-spacing:-1.5px;color:#f5f6f8\">Your invitation<br>starts here.</h1>\n<p class=\"muted\" style=\"margin:24px 0 28px;font-size:16px;line-height:26px;color:#c6c9d0\">You’ve been invited to create a Kinra account. Open your invitation to get started with training, nutrition and recovery in one place.</p>\n<table role=\"presentation\" width=\"100%\" style=\"margin:0 0 28px\"><tr><td class=\"cta\" align=\"center\" bgcolor=\"#c4f65b\" style=\"background:#c4f65b;border-radius:12px;mso-padding-alt:18px 24px\"><a class=\"cta action\" href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:18px 24px;border:1px solid #c4f65b;border-radius:12px;font-size:16px;line-height:20px;font-weight:bold;color:#18200e;background:#c4f65b;text-decoration:none\">Accept invitation &nbsp; &#8594;</a></td></tr></table>\n<p class=\"muted\" style=\"margin:0 0 28px;padding-left:16px;border-left:2px solid #79d5e7;font-size:13px;line-height:21px;color:#c6c9d0\">This invitation creates account access. It does not grant a coach permission to view your records.</p>\n</td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:0 36px 32px;background:#1a1c20;border-radius:0 0 20px 20px\">\n<div style=\"border-top:1px solid #363a42;padding-top:22px\"><p class=\"muted\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#c6c9d0\">Button not working? Copy this link into your browser:</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;font-size:12px;line-height:20px;color:#c4f65b;word-break:break-all;overflow-wrap:anywhere;text-decoration:underline\">{{ .ConfirmationURL }}</a></div>\n</td></tr>\n<tr><td class=\"pad muted\" style=\"padding:24px 36px 0;font-size:12px;line-height:20px;color:#a9aeb8\"><p style=\"margin:0 0 24px\">If you weren’t expecting this invitation, you can ignore this email. Keep this link private.</p><p style=\"margin:0;color:#c6c9d0;font-family:'Courier New',monospace;font-size:10px;letter-spacing:2px\">TRAIN. FUEL. RECOVER.</p><p style=\"margin:8px 0 0\">Your progress, in one place.</p></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n",
  "mailer_subjects_email_change": "Confirm your email change for Kinra",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Confirm your email change for Kinra</title>\n<style>body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}table,td{mso-table-lspace:0;mso-table-rspace:0}table{border-collapse:collapse}img{border:0;outline:none}a{overflow-wrap:anywhere}a:focus-visible{outline:2px solid #79d5e7;outline-offset:4px}@media(max-width:480px){.outer{padding:20px 12px!important}.pad{padding-left:24px!important;padding-right:24px!important}.headline{font-size:34px!important}.action{display:block!important;text-align:center!important}}@media(prefers-color-scheme:dark){.canvas{background:#0f1013!important}.card{background:#1a1c20!important}.copy{color:#f5f6f8!important}.muted{color:#c6c9d0!important}.cta{background:#c4f65b!important;color:#18200e!important}}</style></head>\n<body class=\"canvas\" bgcolor=\"#0f1013\" style=\"margin:0;padding:0;background:#0f1013;color:#f5f6f8;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all\">You requested an email address change for your Kinra account. Confirm this address to continue. You may need to confirm the change from both inboxes.</div>\n<table role=\"presentation\" width=\"100%\" class=\"canvas\" bgcolor=\"#0f1013\"><tr><td class=\"outer\" align=\"center\" style=\"padding:48px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"560\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" style=\"max-width:560px\">\n<tr><td class=\"pad\" style=\"padding:0 36px 26px\"><table role=\"presentation\"><tr><td width=\"48\"><img src=\"{{ .SiteURL }}/brand/kinra-mark.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;width:40px;height:40px\"></td><td style=\"font-size:25px;font-weight:900;letter-spacing:1px;color:#f5f6f8\">KINRA<span style=\"color:#c4f65b\">.</span></td></tr></table></td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:36px 36px 0;background:#1a1c20;border-top:3px solid #c4f65b;border-radius:20px 20px 0 0\">\n<p style=\"margin:0 0 18px;font-family:'Courier New',monospace;font-size:11px;font-weight:bold;line-height:18px;letter-spacing:2px;color:#79d5e7\">ACCOUNT DETAILS</p>\n<h1 class=\"headline copy\" style=\"margin:0;font-size:40px;font-weight:900;line-height:1.08;letter-spacing:-1.5px;color:#f5f6f8\">A new address.<br>The same you.</h1>\n<p class=\"muted\" style=\"margin:24px 0 28px;font-size:16px;line-height:26px;color:#c6c9d0\">You requested an email address change for your Kinra account. Confirm this address to continue. You may need to confirm the change from both inboxes.</p>\n<table role=\"presentation\" width=\"100%\" style=\"margin:0 0 28px\"><tr><td class=\"cta\" align=\"center\" bgcolor=\"#c4f65b\" style=\"background:#c4f65b;border-radius:12px;mso-padding-alt:18px 24px\"><a class=\"cta action\" href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:18px 24px;border:1px solid #c4f65b;border-radius:12px;font-size:16px;line-height:20px;font-weight:bold;color:#18200e;background:#c4f65b;text-decoration:none\">Confirm email change &nbsp; &#8594;</a></td></tr></table>\n<p class=\"muted\" style=\"margin:0 0 28px;padding-left:16px;border-left:2px solid #79d5e7;font-size:13px;line-height:21px;color:#c6c9d0\">Only confirm if you requested this change. This link works once.</p>\n</td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:0 36px 32px;background:#1a1c20;border-radius:0 0 20px 20px\">\n<div style=\"border-top:1px solid #363a42;padding-top:22px\"><p class=\"muted\" style=\"margin:0 0 8px;font-size:12px;line-height:20px;color:#c6c9d0\">Button not working? Copy this link into your browser:</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;font-size:12px;line-height:20px;color:#c4f65b;word-break:break-all;overflow-wrap:anywhere;text-decoration:underline\">{{ .ConfirmationURL }}</a></div>\n</td></tr>\n<tr><td class=\"pad muted\" style=\"padding:24px 36px 0;font-size:12px;line-height:20px;color:#a9aeb8\"><p style=\"margin:0 0 24px\">If you didn’t request this change, don’t use this link. Review your account security in Kinra. Keep this link private.</p><p style=\"margin:0;color:#c6c9d0;font-family:'Courier New',monospace;font-size:10px;letter-spacing:2px\">TRAIN. FUEL. RECOVER.</p><p style=\"margin:8px 0 0\">Your progress, in one place.</p></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n",
  "mailer_subjects_reauthentication": "Your Kinra verification code",
  "mailer_templates_reauthentication_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Your Kinra verification code</title>\n<style>body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}table,td{mso-table-lspace:0;mso-table-rspace:0}table{border-collapse:collapse}img{border:0;outline:none}a{overflow-wrap:anywhere}a:focus-visible{outline:2px solid #79d5e7;outline-offset:4px}@media(max-width:480px){.outer{padding:20px 12px!important}.pad{padding-left:24px!important;padding-right:24px!important}.headline{font-size:34px!important}.action{display:block!important;text-align:center!important}}@media(prefers-color-scheme:dark){.canvas{background:#0f1013!important}.card{background:#1a1c20!important}.copy{color:#f5f6f8!important}.muted{color:#c6c9d0!important}.cta{background:#c4f65b!important;color:#18200e!important}}</style></head>\n<body class=\"canvas\" bgcolor=\"#0f1013\" style=\"margin:0;padding:0;background:#0f1013;color:#f5f6f8;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all\">Enter this code in the Kinra verification screen to confirm it’s you before continuing with your requested account change.</div>\n<table role=\"presentation\" width=\"100%\" class=\"canvas\" bgcolor=\"#0f1013\"><tr><td class=\"outer\" align=\"center\" style=\"padding:48px 16px\">\n<!--[if mso]><table role=\"presentation\" width=\"560\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" style=\"max-width:560px\">\n<tr><td class=\"pad\" style=\"padding:0 36px 26px\"><table role=\"presentation\"><tr><td width=\"48\"><img src=\"{{ .SiteURL }}/brand/kinra-mark.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;width:40px;height:40px\"></td><td style=\"font-size:25px;font-weight:900;letter-spacing:1px;color:#f5f6f8\">KINRA<span style=\"color:#c4f65b\">.</span></td></tr></table></td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:36px 36px 0;background:#1a1c20;border-top:3px solid #c4f65b;border-radius:20px 20px 0 0\">\n<p style=\"margin:0 0 18px;font-family:'Courier New',monospace;font-size:11px;font-weight:bold;line-height:18px;letter-spacing:2px;color:#79d5e7\">QUICK SECURITY CHECK</p>\n<h1 class=\"headline copy\" style=\"margin:0;font-size:40px;font-weight:900;line-height:1.08;letter-spacing:-1.5px;color:#f5f6f8\">One check.<br>Then you’re set.</h1>\n<p class=\"muted\" style=\"margin:24px 0 28px;font-size:16px;line-height:26px;color:#c6c9d0\">Enter this code in the Kinra verification screen to confirm it’s you before continuing with your requested account change.</p>\n<p style=\"margin:0 0 28px;padding:20px 16px;background:#25282e;border:1px solid #3c4149;border-radius:12px;color:#c4f65b;font-family:'Courier New',monospace;font-size:32px;font-weight:bold;letter-spacing:7px;text-align:center\">{{ .Token }}</p>\n<p class=\"muted\" style=\"margin:0 0 28px;padding-left:16px;border-left:2px solid #79d5e7;font-size:13px;line-height:21px;color:#c6c9d0\">Use this code only in the verification screen you opened. Never share it with anyone.</p>\n</td></tr>\n<tr><td class=\"card pad\" bgcolor=\"#1a1c20\" style=\"padding:0 36px 32px;background:#1a1c20;border-radius:0 0 20px 20px\">\n\n</td></tr>\n<tr><td class=\"pad muted\" style=\"padding:24px 36px 0;font-size:12px;line-height:20px;color:#a9aeb8\"><p style=\"margin:0 0 24px\">If you didn’t request this code, you can ignore this email.</p><p style=\"margin:0;color:#c6c9d0;font-family:'Courier New',monospace;font-size:10px;letter-spacing:2px\">TRAIN. FUEL. RECOVER.</p><p style=\"margin:8px 0 0\">Your progress, in one place.</p></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n"
}
